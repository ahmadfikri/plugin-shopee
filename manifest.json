{
  "manifest_version": 3,
  "name": "syabab-affiliathor",
  "version": "0.9.36",
  "description": "Riset pasar & kelayakan iklan langsung di halaman pencarian Shopee. Self-contained, tanpa backend.",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "notifications",
    "offscreen"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "host_permissions": [
    "https://shopee.co.id/*",
    "https://*.shopee.co.id/*",
    "https://affiliate.shopee.co.id/*",
    "https://api.deepseek.com/*",
    "https://*.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.tiktokv.com/*",
    "https://*.byteoversea.com/*",
    "https://*.ibytedtos.com/*",
    "https://*.muscdn.com/*",
    "https://www.facebook.com/ads/library/*",
    "https://*.fbcdn.net/*"
  ],
  "action": {
    "default_title": "Riset Market",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/admin/admin.html",
  "content_scripts": [
    {
      "matches": [
        "https://shopee.co.id/*",
        "https://*.shopee.co.id/*",
        "https://affiliate.shopee.co.id/*"
      ],
      "js": [
        "src/activitylog.js",
        "src/storage.js",
        "src/perf.js",
        "src/epc.js",
        "src/niche.js",
        "src/bandit.js",
        "src/dataset.js",
        "src/shortlist.js",
        "src/scraper.js",
        "src/detailscrape.js",
        "src/enrich.js",
        "src/video.js",
        "src/gahwapack.js",
        "src/proscore.js",
        "src/concepts.js",
        "src/conceptperf.js",
        "src/experiment.js",
        "src/ledger.js",
        "src/analytics.js",
        "src/ai.js",
        "src/charts.js",
        "src/panel.js",
        "src/productpage.js",
        "src/bulkscan.js",
        "src/payout.js",
        "src/content.js"
      ],
      "css": [
        "src/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/ads/library*"
      ],
      "js": [
        "src/fbadlib-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.facebook.com/ads/library*"
      ],
      "js": [
        "src/fbadlib.js",
        "src/fbadlib-content.js"
      ],
      "css": [
        "src/fbadlib.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
