{
  "manifest_version": 3,
  "name": "syabab-affiliathor",
  "version": "0.9.16",
  "description": "Riset pasar & kelayakan iklan langsung di halaman pencarian Shopee. Self-contained, tanpa backend.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://shopee.co.id/*",
    "https://*.shopee.co.id/*",
    "https://affiliate.shopee.co.id/*",
    "https://api.deepseek.com/*"
  ],
  "action": {
    "default_title": "Riset Market",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/admin/admin.html",
  "content_scripts": [
    {
      "matches": [
        "https://shopee.co.id/*",
        "https://*.shopee.co.id/*",
        "https://affiliate.shopee.co.id/*"
      ],
      "js": [
        "src/storage.js",
        "src/perf.js",
        "src/epc.js",
        "src/dataset.js",
        "src/shortlist.js",
        "src/scraper.js",
        "src/detailscrape.js",
        "src/enrich.js",
        "src/video.js",
        "src/proscore.js",
        "src/concepts.js",
        "src/conceptperf.js",
        "src/experiment.js",
        "src/ledger.js",
        "src/analytics.js",
        "src/ai.js",
        "src/charts.js",
        "src/panel.js",
        "src/bulkscan.js",
        "src/content.js"
      ],
      "css": [
        "src/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}